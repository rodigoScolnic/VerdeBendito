<%- include('./partials/head', { pageTitle: "SAVYA | Naturaleza que inspira" }) %>
<body>
  <%- include('./partials/header') %>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow">UN POCO MÁS CERCA DE LO NATURAL</span>
        <h1>Hacé espacio para <em>lo que crece.</em></h1>
        <p>Plantas y detalles naturales para transformar tus espacios en lugares que se sienten vivos.</p>
        <a class="button button-primary" href="/products">Explorar productos <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-art" aria-label="Ilustración botánica">
        <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
        <div class="hero-photo"><img src="/image/leaf.png" alt="Ilustración de una hoja verde"></div>
        <span class="hero-stamp">cultivá<br>tu calma</span>
      </div>
      <span class="hero-side-note">NATURALEZA · DISEÑO · BIENESTAR</span>
    </section>

    <section class="category-section section-wrap" id="categories">
      <div class="section-heading">
        <div><span class="eyebrow">DESCUBRÍ TU RINCÓN VERDE</span><h2>Explorá por categorías</h2></div>
        <a class="text-link" href="/products">Ver todo ↗</a>
      </div>
      <% if (allCategories.length) { %>
        <div class="swiper category-swiper"><div class="swiper-wrapper">
          <% allCategories.forEach(category => { %>
            <a class="swiper-slide category-card" href="/products?category_id=<%= category.id %>">
              <img src="<%= category.image || '/image/all-category.png' %>" alt="<%= category.name %>" loading="lazy">
              <span><%= category.name %></span><b aria-hidden="true">↗</b>
            </a>
          <% }) %>
        </div><div class="swiper-pagination"></div></div>
      <% } else { %><p class="empty-inline">Pronto vas a encontrar nuestras categorías acá.</p><% } %>
    </section>

    <section class="featured-section"><div class="section-wrap">
      <div class="section-heading"><div><span class="eyebrow">SELECCIÓN SAVYA</span><h2>Pequeños favoritos</h2></div><a class="text-link" href="/products">Ver catálogo completo ↗</a></div>
      <div class="products-grid">
        <% featuredProducts.forEach(product => { %>
          <a class="product-card" href="/products/<%= product.id %>">
            <div class="product-image"><img src="<%= product.image || '/image/all-category.png' %>" alt="<%= product.name %>" loading="lazy"><% if (product.stock === 0) { %><span class="stock-tag">Sin stock</span><% } %></div>
            <div class="product-info"><span class="product-category"><%= product.category ? product.category.name : "Colección" %></span><h3><%= product.name %></h3><% if (product.nickname) { %><p><%= product.nickname %></p><% } %><strong>$<%= Number(product.price).toLocaleString("es-AR") %></strong></div>
          </a>
        <% }) %>
      </div>
      <% if (!featuredProducts.length) { %><p class="empty-inline">Estamos preparando nuestra selección. Volvé pronto.</p><% } %>
    </div></section>

    <section class="about-strip section-wrap" id="about">
      <div class="about-mark">✳</div><div><span class="eyebrow">NUESTRA ESENCIA</span><h2>Un hogar con vida se siente distinto.</h2><p>Creemos en los pequeños cambios: una hoja nueva, un rincón cuidado, un momento para conectar con lo natural.</p></div>
      <a class="button button-outline" href="/products">Encontrá tu favorito</a>
    </section>
  </main>
  <footer class="site-footer"><a class="brand" href="/">SAVYA<span>·</span></a><p>Un espacio para conectar con lo natural.</p><small>© <%= new Date().getFullYear() %> SAVYA. Todos los derechos reservados.</small></footer>
</body></html>