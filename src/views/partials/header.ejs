<header class="site-header">
  <div class="header-inner">
    <button class="icon-button h-menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span><span></span></button>
    <a class="brand" href="/" aria-label="SAVYA, inicio">SAVYA<span>·</span></a>
    <div class="header-actions">
      <a class="icon-button cart-link" href="/cart" aria-label="Ver carrito"><svg class="header-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg><span class="cart-count"><%= cartCount || 0 %></span></a>
      <button class="icon-button user-menu-btn" type="button" aria-label="Abrir menú de usuario" aria-expanded="false"><svg class="header-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-1.5a7 7 0 0 1 14 0V21Z"/></svg></button>
    </div>
  </div>
</header>
<nav class="h-menu" aria-label="Navegación principal">
  <a href="/">Inicio</a><a href="/products">Todos los productos</a><a href="/#categories">Categorías</a><a href="/#about">Nuestra esencia</a>
</nav>
<nav class="u-menu" aria-label="Cuenta">
  <% if (user) { %>
    <span class="account-greeting">Hola, <%= user.username %></span>
    <a href="/cart">Mi carrito</a>
    <form action="/logout" method="POST"><button type="submit" class="menu-logout">Cerrar sesión</button></form>
  <% } else { %>
    <a href="/login">Iniciar sesión</a><a href="/register" class="menu-signup">Crear cuenta</a>
  <% } %>
</nav>
<% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>