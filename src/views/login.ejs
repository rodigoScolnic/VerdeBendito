<%- include('./partials/head', { pageTitle: "Iniciar sesión | VERDEBENDITO" }) %>
<body><%- include('./partials/header') %><main class="auth-page"><section class="auth-card">
  <span class="eyebrow">QUÉ BUENO TENERTE DE VUELTA</span><h1>Iniciar sesión</h1><p>Ingresá a tu cuenta para seguir disfrutando de VERDEBENDITO.</p>
  <% if (error) { %><div class="form-alert" role="alert"><%= error %></div><% } %>
  <form action="/login" method="POST" class="auth-form"><label for="email">Correo electrónico</label><input id="email" type="email" name="email" value="<%= oldData.email || '' %>" autocomplete="email" required><label for="password">Contraseña</label><input id="password" type="password" name="password" autocomplete="current-password" required><button class="button button-primary" type="submit">Ingresar</button></form>
  <p class="auth-switch">¿Todavía no tenés cuenta? <a href="/register">Crear cuenta</a></p>
</section></main><footer class="site-footer"><a class="brand" href="/">VERDEBENDITO<span>·</span></a><p>Un espacio para conectar con lo natural.</p></footer></body></html>