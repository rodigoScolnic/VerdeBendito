<%- include('./partials/head', { pageTitle: "Crear cuenta | VERDEBENDITO" }) %>
<body><%- include('./partials/header') %><main class="auth-page"><section class="auth-card">
  <span class="eyebrow">EMPEZÁ TU RINCÓN VERDE</span><h1>Crear cuenta</h1><p>Un pequeño paso para tener tus favoritos siempre a mano.</p>
  <% if (error) { %><div class="form-alert" role="alert"><%= error %></div><% } %>
  <form action="/register" method="POST" class="auth-form"><label for="username">Nombre</label><input id="username" type="text" name="username" value="<%= oldData.username || '' %>" minlength="2" maxlength="40" autocomplete="name" required><label for="email">Correo electrónico</label><input id="email" type="email" name="email" value="<%= oldData.email || '' %>" autocomplete="email" required><label for="password">Contraseña</label><input id="password" type="password" name="password" minlength="8" autocomplete="new-password" required><label for="confirmPassword">Repetir contraseña</label><input id="confirmPassword" type="password" name="confirmPassword" minlength="8" autocomplete="new-password" required><button class="button button-primary" type="submit">Crear mi cuenta</button></form>
  <p class="auth-switch">¿Ya tenés cuenta? <a href="/login">Iniciar sesión</a></p>
</section></main><footer class="site-footer"><a class="brand" href="/">VERDEBENDITO<span>·</span></a><p>Un espacio para conectar con lo natural.</p></footer></body></html>